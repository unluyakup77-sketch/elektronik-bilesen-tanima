# Bu dosyayı ".env" adıyla kopyalayıp düzenleyin. Hiçbiri zorunlu değildir.

# İsteğe bağlı "Çift kontrol" (Gemini ile ikinci görüş). Boşsa karar tamamen CNN'indir.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Tarama geçmişinin tutulduğu SQLite dosyası (varsayılan: backend/data/elektrovision.db)
# DB_PATH=

CORS_ORIGINS=*
